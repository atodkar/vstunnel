# vstunnel Configuration

# Daemon Settings
DAEMON_HOST=localhost
DAEMON_PORT=8080

# Relay Mode (set RELAY_URL to connect to a central relay server)
# When set, the daemon connects outbound to the relay instead of running its own server.
# RELAY_URL=https://vstunnel.siemens.internal
# RELAY_USER_ID=z003vsvd

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
